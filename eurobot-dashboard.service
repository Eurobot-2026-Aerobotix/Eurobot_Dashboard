[Unit]
Description=Eurobot Dashboard Server
After=network.target

[Service]
Type=simple
User=harissa
WorkingDirectory=/home/harissa/Eurobot_Dashboard
Environment="ROS_DISTRO=jazzy"
Environment="ROS_VERSION=2"
Environment="ROS_PYTHON_VERSION=3"
ExecStart=/bin/bash -c 'source /home/harissa/.bashrc && cd /home/harissa/Eurobot_Dashboard && exec python3 /home/harissa/Eurobot_Dashboard/server.py'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target