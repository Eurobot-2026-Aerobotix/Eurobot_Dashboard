[Unit]
Description=Eurobot Dashboard Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Eurobot_Dashboard
Environment="ROS_DISTRO=jazzy"
Environment="ROS_VERSION=2"
Environment="ROS_PYTHON_VERSION=3"
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/ROS2-WS-EURO/install/setup.bash && exec python3 /home/ubuntu/Eurobot_Dashboard/server.py'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target