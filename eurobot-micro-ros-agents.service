[Unit]
Description=Eurobot micro-ROS agents supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harissa
WorkingDirectory=/home/harissa/Eurobot_Dashboard
Environment="ROS_DISTRO=jazzy"
Environment="ROS_VERSION=2"
Environment="ROS_PYTHON_VERSION=3"
Environment="MICRO_ROS_BAUDRATE=115200"
ExecStart=/bin/bash /home/harissa/Eurobot_Dashboard/scripts/start_micro_ros_agents.sh
Restart=always
RestartSec=2
KillMode=control-group
SuccessExitStatus=143 SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
